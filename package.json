{
  "name": "ticket-office",
  "private": true,
  "scripts": {
    "start": "bun --filter '*' dev",
    "clean": "rm -rf node_modules client/node_modules server/node_modules",
    "fresh-install": "bun run clean && bun install",
    "check-outdated": "bun outdated --filter '*'",
    "lint-all": "bun --filter client lint",
    "predeploy": "git switch main && git pull origin main --rebase --tags && git merge origin staging",
    "deploy": "bun pm version --message %s",
    "postdeploy": "git push origin main --tags && git switch staging && git merge origin main && git push"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "version": "4.1.1",
  "devDependencies": {
    "baseline-browser-mapping": "^2.11.19"
  }
}
